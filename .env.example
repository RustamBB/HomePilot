# MCP server
HOMEPILOT_MCP_HOST=127.0.0.1
HOMEPILOT_MCP_PORT=8765
# HOMEPILOT_DATA_FILE=data/state.json   # optional JSON persistence (default: ephemeral)

# API -> MCP
HOMEPILOT_MCP_URL=http://127.0.0.1:8765/mcp

# Agent brain: offline (default, no AWS needed) | bedrock | auto
HOMEPILOT_AGENT=offline
# HOMEPILOT_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# AWS_REGION=us-east-1   # plus AWS credentials / Bedrock API key for bedrock mode
